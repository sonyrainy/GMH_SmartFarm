# EditorConfig: https://editorconfig.org
# Rider / Visual Studio / VS Code 모두 이 파일을 읽어 포맷 규칙을 강제한다.
root = true

# ───────── 공통 ─────────
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# ───────── C# ─────────
[*.cs]
indent_style = space
indent_size = 4

# 중괄호는 문장 끝에 (K&R 스타일), else/catch/finally는 닫는 중괄호와 같은 줄
csharp_new_line_before_open_brace = none
csharp_new_line_before_else = false
csharp_new_line_before_catch = false
csharp_new_line_before_finally = false

# 중괄호: guard clause(if (...) return; / continue;)만 한 줄로 생략, 그 외 분기는 한 문장이라도 항상 사용
csharp_prefer_braces = when_multiline:suggestion

# if / for / while 뒤 한 칸 공백, 함수 이름과 괄호는 붙여쓰기
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_call_name_and_opening_parenthesis = false
csharp_space_between_method_declaration_name_and_open_parenthesis = false

# using 정렬: System.* 먼저
dotnet_sort_system_directives_first = true

# 불필요한 this. 제거
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion

# ── 네이밍 ──
# 인터페이스: I 접두사 (IGameController), 코루틴: Co 접두사 (CoAnimate), Unity 콜백: On 접두사 (OnClick)
# 약어 금지 (Req → Request), 단어로 쓰인 약어는 PascalCase (HttpRequest)
# private 필드: camelCase  (예: currentSpeed)
dotnet_naming_rule.private_fields_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_camel_case.style = camel_case
dotnet_naming_rule.private_fields_camel_case.severity = suggestion
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.camel_case.capitalization = camel_case

# const: PascalCase  (예: GroundTag)
dotnet_naming_rule.constants_pascal_case.symbols = constants
dotnet_naming_rule.constants_pascal_case.style = pascal_case
dotnet_naming_rule.constants_pascal_case.severity = suggestion
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_style.pascal_case.capitalization = pascal_case

# ───────── Unity YAML (씬/프리팹/메타) ─────────
[*.{unity,prefab,asset,meta,mat,anim,controller}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# ───────── Markdown (줄 끝 공백 2개 = 줄바꿈 문법) ─────────
[*.md]
trim_trailing_whitespace = false
